    <string name="cleanup_rescan_title">स्कैन पहले से चल रहा है</string>
    <plurals name="cleanup_rescan_message">
        <item quantity="one">Deja %2$d में से %1$d स्क्रीनशॉट पढ़ चुका है। शुरू से दोबारा करने पर यह प्रोग्रेस मिट जाएगी और सब कुछ फिर से पढ़ा जाएगा।</item>
        <item quantity="other">Deja %2$d में से %1$d स्क्रीनशॉट पढ़ चुका है। शुरू से दोबारा करने पर यह प्रोग्रेस मिट जाएगी और सब कुछ फिर से पढ़ा जाएगा।</item>
    </plurals>
    <string name="cleanup_rescan_confirm">फिर भी शुरू से करें</string>
    <string name="cleanup_forever_title">हमेशा के लिए डिलीट करें?</string>
    <plurals name="cleanup_forever_message">
        <item quantity="one">%1$d स्क्रीनशॉट, कुल %2$s। यह ट्रैश में नहीं जाएगा - न अनडू होगा, न वापस मिलेगा।</item>
        <item quantity="other">%1$d स्क्रीनशॉट, कुल %2$s। ये ट्रैश में नहीं जाएँगे - न अनडू होंगे, न वापस मिलेंगे।</item>
    </plurals>
    <string name="cleanup_forever_confirm">हमेशा के लिए डिलीट करें</string>
    <string name="cleanup_status_loading">देख रहे हैं कि क्या हटाना सुरक्षित है…</string>
    <string name="cleanup_status_indexing">अभी पढ़ना जारी है — जैसे-जैसे Deja आगे बढ़ेगा, यह बढ़ता जाएगा</string>
    <string name="cleanup_status_hint">किसी ग्रुप को शामिल करने या छोड़ने के लिए टैप करें, या उसे खोलकर एक-एक स्क्रीनशॉट चुनें</string>
    <plurals name="cleanup_pinned_kept">
