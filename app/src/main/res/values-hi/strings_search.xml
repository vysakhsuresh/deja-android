<resources>
    <string name="search_title">सर्च</string>
    <string name="search_placeholder">शब्द, कोई ऐप, कोई कैटेगरी…</string>
    <string name="search_clear_query_cd">मिटाएँ</string>
    <string name="search_recent_heading">हाल की सर्च</string>
    <string name="search_clear_recent">मिटाएँ</string>
    <!-- The example query stays in English in every language: dates are read from English words. -->
    <string name="search_intro">स्क्रीनशॉट के अंदर के शब्द, वो किस ऐप से आया, और कब लिया गया — आज़माएँ \"receipt last week\"।</string>
    <string name="search_looking">ढूँढ रहे हैं…</string>
    <string name="search_no_matches">इस डिवाइस पर कुछ नहीं मिला।</string>
    <!-- %1$s is a span of time, e.g. "last week". -->
    <string name="search_no_matches_in">%1$s · इस डिवाइस पर कुछ नहीं मिला।</string>
    <plurals name="search_matches">
        <item quantity="one">%1$d नतीजा · इसी डिवाइस पर सर्च किया</item>
        <item quantity="other">%1$d नतीजे · इसी डिवाइस पर सर्च किया</item>
    </plurals>
    <!-- %2$s is a span of time, e.g. "last week". -->
    <plurals name="search_matches_in">
        <item quantity="one">%2$s · %1$d नतीजा · इसी डिवाइस पर सर्च किया</item>
        <item quantity="other">%2$s · %1$d नतीजे · इसी डिवाइस पर सर्च किया</item>
    </plurals>
